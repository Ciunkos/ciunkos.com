# Cloudflare Pages: files with a content hash in the name never change, so browsers keep them for a year.
# The HTML pages keep the default (revalidate every time), so a deploy shows up at once.
/app-*
  Cache-Control: public, max-age=31536000, immutable
/blog-*
  Cache-Control: public, max-age=31536000, immutable
/ga-*
  Cache-Control: public, max-age=31536000, immutable
/styles-*
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
# Self-hosted PostHog SDK (scripts/vendor-posthog.mjs), shared by every site on ciunkos.com.
# One directory per version and pages load it with an SRI hash, so the file never changes.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
# The Pages hosts (production alias and every preview deployment) stay out of search indexes;
# the canonical in each page already points at ciunkos.com.
https://ciunkos.pages.dev/*
  X-Robots-Tag: noindex, nofollow
https://:deployment.ciunkos.pages.dev/*
  X-Robots-Tag: noindex, nofollow
# HSTS preload, scoped to each custom domain of this Pages project (not ciunkos.pages.dev).
https://ciunkos.com/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
https://przemyslawzalewski.com/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
https://przemyslawzalewski.pl/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
