# Cloudflare Pages: files with a content hash in the name never change, so browsers keep them for a year.
# The HTML pages keep the default (revalidate every time), so a deploy shows up at once.
/app-*
  Cache-Control: public, max-age=31536000, immutable
/blog-*
  Cache-Control: public, max-age=31536000, immutable
/ga-*
  Cache-Control: public, max-age=31536000, immutable
/styles-*
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
# HSTS preload, scoped to each custom domain of this Pages project (not ciunkos.pages.dev).
https://ciunkos.com/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
https://przemyslawzalewski.com/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
https://przemyslawzalewski.pl/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
