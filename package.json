{
  "name": "ciunkos.com",
  "version": "1.0.0",
  "description": "Personal blog and resume",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ciunkos/ciunkos-com.git"
  },
  "scripts": {
    "clean": "node clean.js",
    "build": "node scripts/dates.mjs && npm run clean && NODE_ENV=production webpack --mode production --config webpack.config.cjs && node scripts/vendor-posthog.mjs --check --dist && npm run start:server",
    "check": "npm run test && npm run lint && npm run prettier:check",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "prepare": "husky",
    "prettier": "prettier \"**/*.{js,json,md,css,scss,yml}\"",
    "prettier:check": "npm run prettier -- --check",
    "prettier:debug": "npm run prettier -- --debug-check",
    "prettier:fix": "npm run prettier -- --write",
    "print": "PUBLIC_PATH='' npm run build && node print.js",
    "dates": "node scripts/dates.mjs",
    "start": "webpack serve --mode development --config webpack-dev-server.config.cjs --progress",
    "start:server": "node build/server.cjs",
    "switch-locale": "node switch-locale",
    "switch-locale:en": "node switch-locale en",
    "switch-locale:pl": "node switch-locale pl",
    "test": "echo 'No test specified' && exit 0",
    "vendor:posthog": "node scripts/vendor-posthog.mjs"
  },
  "lint-staged": {
    "*.{js,json,md,css,scss,yml}": "prettier --write"
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "isomorphic-style-loader": "^6.0.0",
    "lint-staged": "^17.6.0",
    "mini-css-extract-plugin": "^2.10.2",
    "playwright": "^1.64.1",
    "posthog-js": "^1.444.0",
    "prettier": "^3.9.10",
    "style-loader": "^4.0.0",
    "terser": "^5.51.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.1.0",
    "webpack-stats-plugin": "^1.1.3"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "highlight.js": "^11.12.0",
    "react": "^19.3.1",
    "react-custom-scrollbars-2": "^4.5.0",
    "react-dom": "^19.3.1",
    "react-helmet": "^6.1.0",
    "react-lowlight": "^3.1.1",
    "react-markdown": "^10.1.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "last 2 iOS versions"
  ],
  "locale": "en",
  "overrides": {
    "react-custom-scrollbars-2": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "react-side-effect": {
      "react": "$react"
    },
    "minimatch": "^11.0.1"
  }
}
